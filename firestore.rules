rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /categorias/{document} {
      allow read: if resource.data.activa == true;
      allow write: if isAdmin();
    }

    match /paquetes/{document} {
      allow read: if resource.data.visible == true;
      allow write: if isAdmin();
    }

    match /consultas/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /club_lado_v/{document} {
      allow create: if request.resource.data.keys().hasOnly([
        'nombre',
        'email',
        'telefono',
        'mensaje',
        'status',
        'source',
        'createdAt',
        'fechaCreacion',
        'tipo',
        'leida',
        'emailLower'
      ]) &&
      request.resource.data.nombre is string &&
      request.resource.data.email is string &&
      request.resource.data.telefono is string &&
      request.resource.data.status in ['lead', 'pending'] &&
      request.resource.data.source in ['landing', 'admin', 'import'];

      allow read, update, delete: if isAdmin();
    }

    match /club_points_ledger/{document} {
      allow read, write: if isAdmin();
    }

    match /club_settings/{document} {
      allow read, write: if isAdmin();
    }

    match /admin_users/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
